# ==========================================
# BharatPass Monorepo .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Sensitive Credentials
# ------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.jks
*.keystore

# ------------------------------------------
# Node.js & Next.js Build Artifacts
# ------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/

# ------------------------------------------
# Java & Maven Build Artifacts
# ------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/
hs_err_pid*
replay_pid*

# ------------------------------------------
# IDEs & System Files
# ------------------------------------------
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.classpath
.project
.settings/

# ------------------------------------------
# Local Logs & Persistent Container Mounts
# ------------------------------------------
*.log
logs/
docker/data/
postgres-data/
minio-data/
redis-data/
scratch/
