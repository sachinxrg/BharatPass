# ==========================================
# BharatPass Backend Environment Config Template
# ==========================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bharatpass
DB_USERNAME=bharatpass
DB_PASSWORD=bharatpass

# Redis Distributed Cache & Redisson Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bharatpass-documents

# UIDAI Data Vault Encryption (AES-256-GCM Master Key)
# In production, provide a 32-character (256-bit) cryptographically random master key
VAULT_MASTER_KEY=changeme-in-production-256bit-key!!

# JWT RSA Key Configuration
JWT_RSA_KEY_PATH=classpath:keys/
